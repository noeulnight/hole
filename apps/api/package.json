{
  "name": "@hole/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "start:debug": "tsx watch --inspect src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "jest --testPathPatterns=\"tests/(app|ssh)\""
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "joi": "^18.0.2",
    "prom-client": "^15.1.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "jest": "^30.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.6",
    "ws": "^8.22.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "../../coverage/api",
    "testEnvironment": "node"
  }
}
